.page-PDEMON .PDEMON-container,
.page-PDEMON .level-container,
.page-PDEMON .meta-container {
    padding-block: 2rem;
}
.page-PDEMON .PDEMON-container {
    padding-inline: 1rem;
}
.page-PDEMON .meta-container {
    padding-right: 2rem;
}

.page-PDEMON .PDEMON {
    table-layout: auto;
}
.page-PDEMON .PDEMON .rank {
    text-align: end;
    padding-right: 1rem;
}
.page-PDEMON .PDEMON .level {
    width: 100%;
}
.page-PDEMON .PDEMON .level button {
    background-color: var(--color-background);
    color: var(--color-on-background);
    border: none;
    border-radius: 0.5rem;
    padding: 1rem;
    text-align: start;
    word-break: normal;
    overflow-wrap: anywhere;
    cursor: pointer;
}
.page-PDEMON .PDEMON .level.error button {
    color: var(--color-error);
    cursor: not-allowed;
    text-decoration: line-through;
}
.page-PDEMON .PDEMON .level button:hover {
    background-color: var(--color-background-hover);
    color: var(--color-on-background-hover);
}
.page-PDEMON .PDEMON .level.active button {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
}
.page-PDEMON .level-container .level {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-right: 2rem;
    max-width: 48rem;
}
.page-PDEMON .level-container .level .level-authors {
    display: grid;
    grid-template-columns: max-content 1fr;
    grid-auto-rows: max-content;
    gap: 1rem;
}
.page-PDEMON .level-container .level .video {
    aspect-ratio: 16/9;
}
.page-PDEMONlist .level-container .level .stats {
    display: flex;
    justify-content: space-evenly;
    text-align: center;
    gap: 2rem;
}
.page-PDEMON .level-container .level .stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}
.page-PDEMON .level-container .level .records {
    table-layout: fixed;
}
.page-PDEMON .level-container .level .records tr td:not(:last-child) {
    padding-right: 1rem;
}
.page-PDEMON .level-container .level .records .percent,
.page-PDEMON .level-container .level .records .user,
.page-PDEMON .level-container .level .records .hz {
    padding-block: 1rem;
}
.page-PDEMON .level-container .level .records .user {
    width: 100%;
}
.page-PDEMON .level-container .level .records .percent,
.page-PDEMON .level-container .level .records .hz {
    text-align: end;
}
.page-PDEMON .meta-container .og a:hover,
.page-PDEMON .level-container .level .records a:hover {
    text-decoration: underline;
}
.page-PDEMON .meta {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}
.page-PDEMON .meta .errors {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
.page-PDEMON .meta .errors .error {
    padding: 1rem;
    background-color: var(--color-error);
    color: var(--color-on-error);
    border-radius: 0.5rem;
}
.page-PDEMON .meta .editors {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}
.page-PDEMON .meta .editors li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.page-PDEMON .meta .editors li img {
    height: 1.25rem;
}
.page-PDEMON .meta .editors li a:hover {
    text-decoration: underline;
}
